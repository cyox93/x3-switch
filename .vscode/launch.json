{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (J-Link)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/x3-switch.elf",
            "servertype": "jlink",
            "device": "MM32F0144C6P",
            "interface": "swd",
            "serialNumber": "",
            "runToEntryPoint": "main",
            "preLaunchTask": "Build",
            "armToolchainPath": "/opt/homebrew/bin",
            "gdbPath": "/opt/homebrew/bin/arm-none-eabi-gdb",
            "showDevDebugOutput": "none"
        }
    ]
}
