{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build",
                "-G", "Ninja",
                "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/arm-none-eabi.cmake",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build"],
            "group": { "kind": "build", "isDefault": true },
            "dependsOn": ["Configure"],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build", "--target", "clean"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Flash",
            "type": "shell",
            "command": "JLinkExe",
            "args": [
                "-device", "MM32F0144C6P",
                "-if", "SWD",
                "-speed", "4000",
                "-autoconnect", "1",
                "-nogui", "1",
                "-CommanderScript", "${workspaceFolder}/scripts/flash.jlink"
            ],
            "group": "build",
            "dependsOn": ["Build"],
            "problemMatcher": []
        }
    ]
}
